{
  "name": "church-accounting-backend",
  "version": "1.0.0",
  "description": "Church Accounting & Audit Management System Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "cd ../frontend && npm install --include=dev && npx vite build",
    "stock:krx:health": "node service/stock/cli/syncKrxOpenApi.js health",
    "stock:krx:sync-master": "node service/stock/cli/syncKrxOpenApi.js sync-master",
    "stock:krx:sync-daily": "node service/stock/cli/syncKrxOpenApi.js sync-daily",
    "stock:fsc:health": "node service/stock/cli/syncFsc.js health",
    "stock:fsc:sync-master": "node service/stock/cli/syncFsc.js sync-master",
    "stock:fsc:sync-daily": "node service/stock/cli/syncFsc.js sync-daily",
    "test:auth": "node tests/auth/resendConfirmation.test.js",
    "test:stock": "node tests/stock/postgresAdapter.test.js",
    "test:contracts": "node tests/stock/publicApiContracts.test.js && node tests/stock/providerContracts.test.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "@supabase/supabase-js": "^2.108.2",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0",
    "tesseract.js": "^5.0.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}